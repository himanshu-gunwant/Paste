# Production Environment Template for Paste Platform
# Copy to .env and fill with real production values:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"

# --- Database & Cache ---
POSTGRES_USER=paste
POSTGRES_PASSWORD=generate_a_strong_password_here
POSTGRES_DB=paste
REDIS_PASSWORD=generate_a_strong_redis_password_here

# --- Domain & URLs ---
# Public URL where users access the frontend:
FRONTEND_ORIGIN=https://paste.yourdomain.com
# Public or internal API URL:
APP_BASE_URL=https://paste.yourdomain.com

# --- Application Security Keys ---
# 32+ bytes hex (used for visitor HMAC hashing)
SESSION_SECRET=paste_64_char_hex_secret_here_replace_me_now
# 32 bytes base64 (used for cookie encryption/signing)
COOKIE_KEYS=paste_44_char_base64_secret_here_replace_me_now

# --- Email (SMTP Provider e.g. Resend, Postmark, SendGrid, Amazon SES) ---
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=re_your_api_key_here
EMAIL_FROM=Paste <no-reply@paste.yourdomain.com>

# --- OAuth (Optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Observability ---
LOG_LEVEL=info

# Frontend Environment Variables Template for Pastebin
# Copy to Frontend/.env.local for local development

# URL where Next.js rewrites proxy client API requests to the Backend
# Local dev: http://localhost:3000
# Docker Compose: http://api:3000
BACKEND_URL=http://localhost:3000

# URL used by Next.js server-side route handlers (e.g. /p/[id]/raw)
# Falls back to BACKEND_URL if unset
INTERNAL_BACKEND_URL=http://localhost:3000
